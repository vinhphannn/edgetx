# SaolaLink V1 baseline copied from RadioMaster Pocket.
# Keep hardware changes here; compare with the Pocket baseline in Studio.
    set(SAOLALINK_HSE_HZ 12000000 CACHE STRING "SaolaLink crystal: 8000000 (DevEBox) or 12000000 (Pocket-compatible)")
    if(NOT SAOLALINK_HSE_HZ MATCHES "^(8000000|12000000)$")
      message(FATAL_ERROR "SAOLALINK_HSE_HZ must be 8000000 or 12000000")
    endif()
    set(HSE_VALUE ${SAOLALINK_HSE_HZ})
    set(HAPTIC YES)
    set(DEFAULT_INTERNAL_MODULE CROSSFIRE CACHE STRING "Default internal module")
    set(INTERNAL_MODULE_SERIAL YES)
    set(MODULE_SIZE_SML YES)
    set(FLAVOUR saolalinkv1)
    set(CPU_TYPE_FULL STM32F407xE)
    set(ROTARY_ENCODER YES)
    set(USB_CHARGER YES)
    set(PXX2 ON)
    set(ENABLE_SERIAL_PASSTHROUGH ON CACHE BOOL "Enable serial passthrough")
    if (NOT BLUETOOTH)
      set(AUX_SERIAL ON)
    endif()
    option(SAOLALINK_DEVEBOX "DevEBox USB-powered development board without LCD/SD" OFF)
    if(SAOLALINK_DEVEBOX)
      if(NOT SAOLALINK_HSE_HZ STREQUAL "8000000")
        message(FATAL_ERROR "DevEBox requires SAOLALINK_HSE_HZ=8000000")
      endif()
      add_definitions(-DSAOLALINK_DEVEBOX)
      include_directories(${RADIO_SRC_DIR}/thirdparty/STM32_USB_Device_Library/Core/Inc
                          ${RADIO_SRC_DIR}/thirdparty/STM32_USB_Device_Library/Class/DFU/Inc)
      set(USB_SERIAL ON CACHE BOOL "USB CDC CLI for development" FORCE)
      set(CLI ON)
      set(USB_CHARGER NO)
      set(HAPTIC NO)
      # JSON declares encoder navigation; retain its driver even on the bare board.
      set(ROTARY_ENCODER YES)
      set(INTERNAL_MODULES CRSF CACHE STRING "DevEBox internal module protocols" FORCE)
      set(INTERNAL_MODULE_CRSF ON CACHE BOOL "Support internal CRSF" FORCE)
      set(INTERNAL_MODULE_MULTI OFF CACHE BOOL "No internal MULTI on DevEBox" FORCE)
      set(HARDWARE_INTERNAL_MODULE YES)
      set(HARDWARE_EXTERNAL_MODULE NO)
      list(APPEND BOOTLOADER_SRC ${RADIO_SRC_DIR}/targets/taranis/saolalink_v1/devebox_dfu.cpp)
    endif()
