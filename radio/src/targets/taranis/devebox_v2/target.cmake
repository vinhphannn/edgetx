# DevEBox 8 MHz V2: independent hardware description, base SSD1309 SPI display.
set(SAOLALINK_HSE_HZ 8000000 CACHE STRING "DevEBox V2 crystal frequency")
if(NOT SAOLALINK_HSE_HZ STREQUAL "8000000")
  message(FATAL_ERROR "DevEBox V2 requires an 8 MHz HSE")
endif()
if(BLUETOOTH)
  message(FATAL_ERROR "DevEBox V2 S2 uses PA6; BLUETOOTH must be OFF")
endif()
set(SAOLALINK_DEVEBOX ON CACHE BOOL "DevEBox USB loader family" FORCE)
set(SAOLALINK_DEVEBOX_V2 ON)
# Reuse the established F407 peripheral layout; V2 has its own RADIO identity.
set(RADIO_SAOLALINKV1 YES)
add_definitions(-DSAOLALINK_DEVEBOX -DSAOLALINK_DEVEBOX_V2 -DRADIO_SAOLALINKV1)
set(HSE_VALUE 8000000)
set(FLAVOUR devebox8v2)
set(CPU_TYPE_FULL STM32F407xE)
set(DEFAULT_INTERNAL_MODULE CROSSFIRE CACHE STRING "Default internal module")
set(INTERNAL_MODULE_SERIAL YES)
set(MODULE_SIZE_SML YES)
set(ROTARY_ENCODER YES)
set(PXX2 ON)
set(USB_SERIAL ON CACHE BOOL "USB CDC CLI" FORCE)
set(CLI ON)
set(USB_CHARGER NO)
set(HAPTIC NO)
set(AUX_SERIAL ON)
set(ENABLE_SERIAL_PASSTHROUGH ON CACHE BOOL "Enable serial passthrough")
set(INTERNAL_MODULES CRSF CACHE STRING "DevEBox V2 internal module protocols" FORCE)
set(INTERNAL_MODULE_CRSF ON CACHE BOOL "Support internal CRSF" FORCE)
set(INTERNAL_MODULE_MULTI OFF CACHE BOOL "No internal MULTI" FORCE)
set(HARDWARE_INTERNAL_MODULE YES)
set(HARDWARE_EXTERNAL_MODULE NO)
set(LCD_DRIVER lcd_driver_spi.cpp)
include_directories(${RADIO_SRC_DIR}/thirdparty/STM32_USB_Device_Library/Core/Inc
                    ${RADIO_SRC_DIR}/thirdparty/STM32_USB_Device_Library/Class/DFU/Inc)
# The validated application-only loader is deliberately shared with the base.
list(APPEND BOOTLOADER_SRC ${RADIO_SRC_DIR}/targets/taranis/saolalink_v1/devebox_dfu.cpp)
